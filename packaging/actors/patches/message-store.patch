 namespace {
 
+class BlockingTestRuntime {
+public:
+  explicit BlockingTestRuntime(
+      const std::shared_ptr<obcx::core::ActorServices> &services)
+      : work_(boost::asio::make_work_guard(io_)),
+        blocking_executor_(std::make_shared<obcx::core::BlockingExecutor>(2)),
+        io_thread_([this] { io_.run(); }) {
+    services->register_service<obcx::core::BlockingExecutor>(
+        blocking_executor_);
+    services->register_service<boost::asio::any_io_executor>(
+        std::make_shared<boost::asio::any_io_executor>(io_.get_executor()));
+  }
+
+  BlockingTestRuntime(const BlockingTestRuntime &) = delete;
+  auto operator=(const BlockingTestRuntime &) -> BlockingTestRuntime & = delete;
+
+  ~BlockingTestRuntime() {
+    blocking_executor_->shutdown();
+    work_.reset();
+    io_.stop();
+    if (io_thread_.joinable()) {
+      io_thread_.join();
+    }
+  }
+
+private:
+  boost::asio::io_context io_;
+  boost::asio::executor_work_guard<boost::asio::io_context::executor_type>
+      work_;
+  std::shared_ptr<obcx::core::BlockingExecutor> blocking_executor_;
+  std::thread io_thread_;
+};
