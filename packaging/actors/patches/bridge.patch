+auto table_exists(obcx::core::IDbConnection &connection,
+                  const std::string_view table) -> bool {
+  return !connection
+              .query("SELECT name FROM sqlite_master WHERE type = 'table' "
+                     "AND name = ?;",
+                     {std::string{table}})
+              .empty();
+}
