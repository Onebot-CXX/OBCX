+auto manager_for(const std::filesystem::path &path)
+    -> std::shared_ptr<obcx::core::DbManager> {
+  auto manager = std::make_shared<obcx::core::DbManager>();
+  manager->configure({sqlite_config("main", path)});
+  return manager;
