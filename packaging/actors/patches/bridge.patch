+          VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+          ON CONFLICT(installation_id, platform, sticker_hash) DO UPDATE SET
+            sticker_id = excluded.sticker_id,
+            original_name = excluded.original_name,
+            file_type = excluded.file_type,
