-auto QQEventHandler::escape_markdown_v2(const std::string &text)
-    -> std::string {
-  std::string result;
-  result.reserve(text.size() * 2);
-  for (char c : text) {
-    if (c == '_' || c == '*' || c == '[' || c == ']' || c == '(' || c == ')' ||
-        c == '~' || c == '`' || c == '>' || c == '#' || c == '+' || c == '-' ||
-        c == '=' || c == '|' || c == '{' || c == '}' || c == '.' || c == '!') {
-      result += '\\';
-    }
-    result += c;
-  }
-  return result;
-}
