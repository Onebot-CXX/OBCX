# Build an x86_64 or arm64 Linux OBCX runtime image using the admitted GCC 16
# Nix flake dev shell.
#
# Build:
#   podman build --platform linux/amd64 --security-opt seccomp=unconfined -f packaging/podman/Containerfile -t obcx:nix-amd64 .
#   podman build --platform linux/arm64 --security-opt seccomp=unconfined -f packaging/podman/Containerfile -t obcx:nix-arm64 .
#
# Run with a deployment configuration mounted read-only:
#   podman run --rm -v "$PWD/config.toml:/config/config.toml:ro" obcx:nix-amd64

FROM docker.io/nixos/nix:latest AS builder

WORKDIR /workspace
ARG CMAKE_BUILD_TYPE=Release
ARG CMAKE_BUILD_PARALLEL_LEVEL=

RUN mkdir -p /etc/nix \
  && printf 'experimental-features = nix-command flakes\nfilter-syscalls = false\n' >> /etc/nix/nix.conf

COPY flake.nix flake.lock ./
RUN nix develop .#default --command true
RUN nix develop .#default --command sh -ceu \
  'test "$(g++ -dumpversion | cut -d. -f1)" -ge 16; \
   printf "#include <meta>\n" \
     | g++ -std=c++26 -freflection -x c++ -E - >/dev/null'

COPY . .
RUN nix develop .#default --command \
      sh packaging/actors/restore-sources.sh bridge message-store
RUN rm -rf build \
  && nix develop .#default --command cmake -S . -B build -GNinja \
       -DCMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE}" \
       -DOBCX_BUILD_TESTS=OFF \
       -DOBCX_BUILD_BENCHMARKS=OFF \
  && if [ -n "${CMAKE_BUILD_PARALLEL_LEVEL:-}" ]; then \
       nix develop .#default --command cmake --build build --parallel "${CMAKE_BUILD_PARALLEL_LEVEL}"; \
     else \
       nix develop .#default --command cmake --build build; \
     fi \
  && nix develop .#default --command cmake --install build --prefix /opt/obcx

RUN set -eu; \
    for actor in obcx-message-store obcx-message-bridge; do \
      nix develop .#default --command env \
        ACTOR_SOURCE="local_actor/${actor}" \
        ACTOR_BUILD="build/${actor}" \
        ACTOR_BUILD_TYPE="${CMAKE_BUILD_TYPE}" \
        sh -ceu 'cmake -S "$ACTOR_SOURCE" -B "$ACTOR_BUILD" -GNinja \
          -DCMAKE_BUILD_TYPE="$ACTOR_BUILD_TYPE" \
          -DBUILD_TESTING=OFF \
          -DCMAKE_PREFIX_PATH="/opt/obcx;${CMAKE_PREFIX_PATH:-}"'; \
      if [ -n "${CMAKE_BUILD_PARALLEL_LEVEL:-}" ]; then \
        nix develop .#default --command cmake --build "build/${actor}" \
          --parallel "${CMAKE_BUILD_PARALLEL_LEVEL}"; \
      else \
        nix develop .#default --command cmake --build "build/${actor}"; \
      fi; \
      nix develop .#default --command cmake --install "build/${actor}" \
        --prefix /opt/obcx; \
    done

RUN mkdir -p /runtime-root/opt/obcx /runtime-root/workspace/logs \
       /runtime-root/etc/obcx \
  && cp -a /opt/obcx/. /runtime-root/opt/obcx/ \
  && cp actors-example.toml /runtime-root/etc/obcx/actors-example.toml \
  && FFMPEG_BIN="$(nix develop .#default --command sh -c 'command -v ffmpeg')" \
  && SH_BIN="$(nix develop .#default --command sh -c 'command -v sh')" \
  && AWK_BIN="$(nix develop .#default --command sh -c 'command -v awk')" \
  && test -x "${FFMPEG_BIN}" \
  && test -x "${SH_BIN}" \
  && test -x "${AWK_BIN}" \
  && { \
       printf '%s\n' "${FFMPEG_BIN}"; \
       printf '%s\n' "${SH_BIN}"; \
       find /runtime-root/opt/obcx -type f -print0 \
         | xargs -0 -r ldd 2>/dev/null \
         | "${AWK_BIN}" '/=> \/nix\/store\// { print $3 } /^[[:space:]]*\/nix\/store\// { print $1 }'; \
       find /runtime-root/opt/obcx -type f \
         -exec grep -aoh '/nix/store/[[:alnum:]]\{32\}-[^/:[:space:]]*' {} + \
         2>/dev/null; \
     } | sort -u \
    | while read -r store_path; do \
        [ -e "${store_path}" ] && printf '%s\n' "${store_path}"; \
      done \
    | xargs -r nix-store -qR \
    | sort -u \
    | xargs -I{} cp -a --parents {} /runtime-root \
  && mkdir -p /runtime-root/usr/local/bin /runtime-root/bin \
  && ln -s "${FFMPEG_BIN}" /runtime-root/usr/local/bin/ffmpeg \
  && ln -s "${SH_BIN}" /runtime-root/bin/sh \
  && test -x /runtime-root/opt/obcx/bin/obcx \
  && test -f /runtime-root/opt/obcx/lib/obcx/actors/message_store.so \
  && test -f /runtime-root/opt/obcx/lib/obcx/actors/bridge.so \
  && test -x /runtime-root/usr/local/bin/ffmpeg \
  && test -x /runtime-root/bin/sh \
  && test -d /runtime-root/nix/store

FROM scratch AS runtime

COPY --from=builder /runtime-root /

ENV PATH="/usr/local/bin"

WORKDIR /workspace
VOLUME ["/config"]
CMD ["/opt/obcx/bin/obcx", "--no-tui", "/config/config.toml"]
