watch_file packages.toml scripts/nix_develop.py

# nix-direnv 3.2.0 touches flake-profile-*.rc when refreshing GC roots.
# Those cache files are watched, so other shells reload even without input
# changes. Refresh only GC-root symlinks; keep watching the cache so actual
# environment rebuilds still propagate to other shells.
if [[ ${NIX_DIRENV_VERSION-} == 3.2.0 ]]; then
  _nix_refresh_gcroots() {
    local layout_dir
    layout_dir=$(direnv_layout_dir)
    local root
    for root in "$layout_dir"/flake-profile-* "$layout_dir"/flake-inputs/* "$layout_dir"/nix-profile-*; do
      [[ -L $root ]] || continue
      if ! touch -h "$root"; then
        _nix_direnv_warning "could not refresh gcroot: $root"
      fi
    done
  }
fi

use flake
