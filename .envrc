# Builtin use_flake must stop before profile maintenance if Nix evaluation fails.
set -e

# Under manual reload these only mark the cache stale; nix-direnv-reload
# rebuilds nothing unless a watched file is newer than the cache.
watch_file packages.toml scripts/nix_develop.py cmake/obcx_package/*.py

# nix-direnv 3.2.0 touches flake-profile-*.rc when refreshing GC roots.
# Those cache files are watched, so other shells reload even without input
# changes. Refresh only GC-root symlinks; keep watching the cache so actual
# environment rebuilds still propagate to other shells.
if [[ ${NIX_DIRENV_VERSION-} == 3.2.0 ]]; then
  _nix_refresh_gcroots() {
    local layout_dir
    layout_dir=$(direnv_layout_dir)
    local root
    for root in "$layout_dir"/flake-profile-* "$layout_dir"/flake-inputs/* "$layout_dir"/nix-profile-*; do
      [[ -L $root ]] || continue
      if ! touch -h "$root"; then
        _nix_direnv_warning "could not refresh gcroot: $root"
      fi
    done
  }
fi

# Dependencies change rarely, so an existing nix-direnv cache is reused until
# nix-direnv-reload. Without a cache the first load must still evaluate, or the
# shell would get no environment at all.
obcx_flake() {
  if declare -F nix_direnv_manual_reload >/dev/null; then
    nix_direnv_disallow_fallback 2>/dev/null
    if declare -F _nix_argsum_suffix >/dev/null &&
      [[ -e "$(direnv_layout_dir)/flake-profile$(_nix_argsum_suffix "$1").rc" ]]; then
      nix_direnv_manual_reload
    fi
  fi
  use flake "$@"
}

obcx_use_flake() {
  local python system inputs shells shell
  if python=$(command -v python3) &&
    "$python" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    case "$(uname -s)-$(uname -m)" in
      Darwin-arm64) system=aarch64-darwin ;;
      Linux-x86_64) system=x86_64-linux ;;
      Linux-aarch64 | Linux-arm64) system=aarch64-linux ;;
      *) obcx_flake .; return $? ;;
    esac
    if inputs=$("$python" scripts/nix_develop.py \
      --workspace "$PWD/packages.toml" \
      --cache "$PWD/build/actor-dev/package-state/sources" \
      --mode development --network allow \
      --nix-system "$system" --shell workspace --print-inputs 2>/dev/null) &&
      shells=$("$python" -c '
import json, sys
shells = json.loads(sys.argv[1])["shells"]
if not shells:
    sys.exit(1)
for shell in shells:
    print(shell["path"])
' "$inputs"); then
      while IFS= read -r shell; do
        watch_file "$shell"
      done <<< "$shells"
      export OBCX_NIX_SHELL_INPUTS="$inputs"
      obcx_flake .#workspace --impure
      return $?
    fi
  fi
  # The default shell supplies Python and reports resolver failures in its hook.
  obcx_flake .
}

obcx_use_flake
unset -f obcx_use_flake obcx_flake
