{
  "$id": "https://onebot-cxx.github.io/obcx/schemas/workspace.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "providers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "components": {
            "items": {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.+-]+$",
              "type": "string"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "cmake-config",
              "cmake-module",
              "pkg-config",
              "workspace-sdk",
              "installed-sdk"
            ],
            "type": "string"
          },
          "package": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.+-]+$",
            "type": "string"
          },
          "package_manager": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "none"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "baseline": {
                    "minLength": 1,
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string"
                  },
                  "default_features": {
                    "type": "boolean"
                  },
                  "features": {
                    "items": {
                      "minLength": 1,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "type": "string"
                    },
                    "minItems": 0,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "kind": {
                    "enum": [
                      "vcpkg"
                    ],
                    "type": "string"
                  },
                  "port": {
                    "minLength": 1,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "port",
                  "features",
                  "default_features",
                  "baseline"
                ],
                "type": "object"
              }
            ]
          },
          "provenance": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "nix",
                  "vcpkg",
                  "environment",
                  "workspace-sdk",
                  "installed-sdk"
                ],
                "type": "string"
              },
              "path": {
                "format": "relative-path",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "type": "object"
          },
          "targets": {
            "items": {
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_.+-]*(?:::[A-Za-z_][A-Za-z0-9_.+-]*)+$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "version": {
            "minLength": 1,
            "type": "string"
          },
          "version_probe": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "cmake-variable"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "minLength": 1,
                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "name"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "target-property"
                    ],
                    "type": "string"
                  },
                  "property": {
                    "minLength": 1,
                    "pattern": "^[A-Z_][A-Z0-9_]*$",
                    "type": "string"
                  },
                  "target": {
                    "minLength": 1,
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.+-]*(?:::[A-Za-z_][A-Za-z0-9_.+-]*)+$",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "target",
                  "property"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "pkg-config"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "receipt"
                    ],
                    "type": "string"
                  },
                  "path": {
                    "format": "relative-path",
                    "minLength": 1,
                    "type": "string"
                  },
                  "sha256": {
                    "minLength": 1,
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "sha256"
                ],
                "type": "object"
              }
            ]
          },
          "version_scheme": {
            "enum": [
              "semver",
              "numeric"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "package",
          "components",
          "targets",
          "version",
          "version_scheme",
          "version_probe",
          "package_manager",
          "provenance"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "sources": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "id": {
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "path"
                ],
                "type": "string"
              },
              "path": {
                "format": "relative-path",
                "minLength": 1,
                "type": "string"
              },
              "provenance": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "working-tree"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "commit": {
                        "minLength": 1,
                        "pattern": "^[0-9a-f]{40}$",
                        "type": "string"
                      },
                      "kind": {
                        "enum": [
                          "git"
                        ],
                        "type": "string"
                      },
                      "repository": {
                        "format": "https",
                        "minLength": 1,
                        "type": "string"
                      },
                      "subdir": {
                        "format": "subdir",
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "repository",
                      "commit",
                      "subdir"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "archive"
                        ],
                        "type": "string"
                      },
                      "path": {
                        "format": "relative-path",
                        "minLength": 1,
                        "type": "string"
                      },
                      "sha256": {
                        "minLength": 1,
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "path",
                      "sha256"
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "path",
              "provenance"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "commit": {
                "minLength": 1,
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              "id": {
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "git"
                ],
                "type": "string"
              },
              "repository": {
                "format": "https",
                "minLength": 1,
                "type": "string"
              },
              "subdir": {
                "format": "subdir",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "repository",
              "commit",
              "subdir"
            ],
            "type": "object"
          }
        ]
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "workspace": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "enum": [
            "linux-x86_64",
            "linux-arm64"
          ],
          "type": "string"
        },
        "profile": {
          "enum": [
            "production",
            "tests"
          ],
          "type": "string"
        },
        "roots": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "roots",
        "platform",
        "profile"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "workspace",
    "sources",
    "providers"
  ],
  "title": "OBCX v2 workspace",
  "type": "object"
}
