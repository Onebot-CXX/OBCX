{
  "$id": "https://onebot-cxx.github.io/obcx/schemas/provider-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "files": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "minLength": 1,
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "name": {
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.+-]*(?:::[A-Za-z_][A-Za-z0-9_.+-]*)+$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "files"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "version": {
      "minLength": 1,
      "type": "string"
    },
    "version_scheme": {
      "enum": [
        "semver",
        "numeric"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "version_scheme",
    "targets"
  ],
  "title": "OBCX v2 provider-receipt",
  "type": "object"
}
